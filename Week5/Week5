#include<stdio.h>
int main(){

    float salary = 0.00;
    float total  = 0.00;
    float highest = 0.00;
    float lowest = 0.00;
    float average = 0.00;
    
    for(int i = 1; i<=50; i++){
        printf("Enter salary for employee %d :", i);
        scanf("%f", &salary);
         total = total + salary;

         if(i == 1){
            highest = salary;
            lowest - salary;
         }
         if (salary > highest){
             highest = salary;
         }
         if(salary < lowest){
             lowest = salary;
         }
    }
      average = total /50;

      printf("\n-- SALARY REPORT--\n");
      printf("Average salary : %.2f\n", average);
      printf("higherst salary : %.2f\n", highest);
      printf("lowest salary : %.2f\n", lowest);
    return 0 ;  
}